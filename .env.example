# Copy this file to .env in the repository root and add local values there.

# Application
NODE_ENV=development
API_PORT=3001
ADMIN_PORT=3000
ADMIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Neon PostgreSQL
# Use the pooled Neon connection for runtime application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?channel_binding=require&sslmode=require

# Use the direct Neon connection for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudflare R2 (platform-level fallback storage)
# Generate an R2 S3 API token and expose files through an r2.dev or custom
# public domain URL. Keep real credentials in deployment secret storage.
# These are the fallback used by sites that have not configured their own
# storage in Site Settings (per-site config takes precedence).
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Per-site storage credentials are encrypted at rest with this key (AES-256-GCM).
# Required only for per-site storage configured through the admin UI.
# Generate one with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=your_64_hex_char_key_here
 