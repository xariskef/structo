    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@structo/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.22.3"
  }
