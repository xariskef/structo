{
  "name": "structo-cms",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xariskef/structo.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.5.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:generate": "corepack pnpm --filter @structo/database db:generate",
    "db:validate": "corepack pnpm --filter @structo/database db:validate",
    "db:format": "corepack pnpm --filter @structo/database db:format",
    "db:migrate": "corepack pnpm --filter @structo/database db:migrate",
    "db:deploy": "corepack pnpm --filter @structo/database db:deploy",
    "db:studio": "corepack pnpm --filter @structo/database db:studio",
    "db:grant-operator": "corepack pnpm --filter @structo/database db:grant-operator",
    "deps:verify": "node scripts/verify-dependencies.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.4",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
