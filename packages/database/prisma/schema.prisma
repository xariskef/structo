generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformOperatorRole {
  PLATFORM_ADMIN
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  ANALYST
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum SiteMembershipRole {
  SITE_ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  platformOperatorAccess  PlatformOperatorAccess?
  passwordCredential      PasswordCredential?
  sessions                AuthSession[]
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMembership[]
  siteMemberships         SiteMembership[]
  createdInvitations      Invitation[]             @relation("InvitationCreator")
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PlatformOperatorAccess {
  id        String               @id @default(cuid())
  userId    String               @unique
  role      PlatformOperatorRole @default(PLATFORM_ADMIN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  createdBy   User                     @relation("OrganizationCreator", fields: [createdById], references: [id])
  memberships OrganizationMembership[]
  sites       Site[]
  invitations Invitation[]

  @@index([createdById])
}

model OrganizationMembership {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMembershipRole
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Site {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  key            String           @unique
  slug           String
  status         SiteStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    SiteMembership[]
  invitations    Invitation[]
  settings       SiteSetting[]
  contentTypes   ContentType[]
  entries        ContentEntry[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  siteId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([siteId])
}

enum ContentTypeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContentEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentTypeKind {
  COLLECTION
  SINGLE
}

model ContentType {
  id           String            @id @default(cuid())
  siteId       String
  kind         ContentTypeKind   @default(COLLECTION)
  name         String
  singularName String?
  pluralName   String?
  slug         String
  description  String?
  status       ContentTypeStatus @default(DRAFT)
  fields       Json              @default("[]")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  site     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions ContentTypeVersion[]
  entries  ContentEntry[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model ContentTypeVersion {
  id            String   @id @default(cuid())
  contentTypeId String
  version       Int
  fields        Json
  createdById   String?
  createdAt     DateTime @default(now())

  contentType ContentType    @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  entries     ContentEntry[]

  @@unique([contentTypeId, version])
  @@index([contentTypeId])
}

model ContentEntry {
  id                   String              @id @default(cuid())
  siteId               String
  contentTypeId        String
  contentTypeVersionId String
  title                String
  slug                 String
  status               ContentEntryStatus  @default(DRAFT)
  data                 Json                @default("{}")
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  site               Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType        ContentType        @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  contentTypeVersion ContentTypeVersion @relation(fields: [contentTypeVersionId], references: [id])
  revisions          ContentRevision[]

  @@unique([contentTypeId, slug])
  @@index([siteId, status])
  @@index([contentTypeId])
}

model ContentRevision {
  id          String             @id @default(cuid())
  entryId     String
  revision    Int
  data        Json
  status      ContentEntryStatus
  createdById String?
  createdAt   DateTime           @default(now())

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, revision])
  @@index([entryId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  siteId         String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([siteId])
  @@index([actorId])
  @@index([createdAt])
}

model SiteMembership {
  id        String             @id @default(cuid())
  siteId    String
  userId    String
  role      SiteMembershipRole
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  site      Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([userId])
}

model Invitation {
  id               String                      @id @default(cuid())
  email            String
  organizationId   String
  siteId           String?
  organizationRole OrganizationMembershipRole?
  siteRole         SiteMembershipRole?
  tokenHash        String                      @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdById      String
  createdAt        DateTime                    @default(now())
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site?                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy        User                        @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([siteId])
  @@index([email])
  @@index([expiresAt])
}
