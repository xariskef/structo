generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformOperatorRole {
  PLATFORM_ADMIN
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  ANALYST
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum SiteMembershipRole {
  SITE_ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  platformOperatorAccess  PlatformOperatorAccess?
  passwordCredential      PasswordCredential?
  sessions                AuthSession[]
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMembership[]
  siteMemberships         SiteMembership[]
  createdInvitations      Invitation[]             @relation("InvitationCreator")
  createdPreviewTokens    PreviewToken[]           @relation("PreviewTokenCreator")
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PlatformOperatorAccess {
  id        String               @id @default(cuid())
  userId    String               @unique
  role      PlatformOperatorRole @default(PLATFORM_ADMIN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  createdBy   User                     @relation("OrganizationCreator", fields: [createdById], references: [id])
  memberships OrganizationMembership[]
  sites       Site[]
  invitations Invitation[]

  @@index([createdById])
}

model OrganizationMembership {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMembershipRole
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Site {
  id                    String                     @id @default(cuid())
  organizationId        String
  name                  String
  key                   String                     @unique
  slug                  String
  status                SiteStatus                 @default(ACTIVE)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships           SiteMembership[]
  invitations           Invitation[]
  settings              SiteSetting[]
  contentTypes          ContentType[]
  entries               ContentEntry[]
  taxonomyDefinitions   TaxonomyDefinition[]
  taxonomyTerms         TaxonomyTerm[]
  contentTypeTaxonomies ContentTypeTaxonomy[]
  entryTaxonomyTerms    ContentEntryTaxonomyTerm[]
  navigationMenus       NavigationMenu[]
  apiTokens             SiteApiToken[]
  previewTokens         PreviewToken[]
  mediaAssets           MediaAsset[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model SiteApiToken {
  id         String    @id @default(cuid())
  siteId     String
  name       String
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model MediaAsset {
  id              String   @id @default(cuid())
  siteId          String
  storageProvider String
  storageKey      String   @unique
  url             String
  filename        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  alt             String?
  caption         String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model NavigationMenu {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  key       String
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([siteId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  siteId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([siteId])
}

enum ContentTypeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContentEntryStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentTypeKind {
  COLLECTION
  SINGLE
}

enum TaxonomyKind {
  CATEGORY
  TAG
}

enum TaxonomyScope {
  PAGES
  CONTENT_TYPE
}

model ContentType {
  id           String            @id @default(cuid())
  siteId       String
  kind         ContentTypeKind   @default(COLLECTION)
  name         String
  singularName String?
  pluralName   String?
  slug         String
  description  String?
  status       ContentTypeStatus @default(DRAFT)
  fields       Json              @default("[]")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  site                Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions            ContentTypeVersion[]
  entries             ContentEntry[]
  taxonomies          ContentTypeTaxonomy[]
  taxonomyDefinitions TaxonomyDefinition[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model ContentTypeVersion {
  id            String   @id @default(cuid())
  contentTypeId String
  version       Int
  fields        Json
  createdById   String?
  createdAt     DateTime @default(now())

  contentType ContentType    @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  entries     ContentEntry[]

  @@unique([contentTypeId, version])
  @@index([contentTypeId])
}

model ContentEntry {
  id                   String             @id @default(cuid())
  siteId               String
  contentTypeId        String
  contentTypeVersionId String
  title                String
  slug                 String
  status               ContentEntryStatus @default(DRAFT)
  data                 Json               @default("{}")
  excerpt              String?
  seoTitle             String?
  seoDescription       String?
  publishedAt          DateTime?
  publishedRevisionId  String?            @unique
  createdById          String?
  updatedById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  site               Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType        ContentType                @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  contentTypeVersion ContentTypeVersion         @relation(fields: [contentTypeVersionId], references: [id])
  revisions          ContentRevision[]          @relation("EntryRevisions")
  publishedRevision  ContentRevision?           @relation("EntryPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  taxonomyTerms      ContentEntryTaxonomyTerm[]
  previewTokens      PreviewToken[]

  @@unique([contentTypeId, slug])
  @@index([siteId, status])
  @@index([status, publishedAt])
  @@index([contentTypeId])
}

model TaxonomyDefinition {
  id            String        @id @default(cuid())
  siteId        String
  contentTypeId String?
  scope         TaxonomyScope
  scopeKey      String
  kind          TaxonomyKind
  fields        Json          @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  site        Site                        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType ContentType?                @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  versions    TaxonomyDefinitionVersion[]
  terms       TaxonomyTerm[]

  @@unique([siteId, scopeKey, kind])
  @@index([contentTypeId])
}

model TaxonomyDefinitionVersion {
  id                   String   @id @default(cuid())
  taxonomyDefinitionId String
  version              Int
  fields               Json
  createdById          String?
  createdAt            DateTime @default(now())

  taxonomyDefinition TaxonomyDefinition @relation(fields: [taxonomyDefinitionId], references: [id], onDelete: Cascade)
  terms              TaxonomyTerm[]

  @@unique([taxonomyDefinitionId, version])
  @@index([taxonomyDefinitionId])
}

model TaxonomyTerm {
  id                          String       @id @default(cuid())
  siteId                      String
  taxonomyDefinitionId        String
  taxonomyDefinitionVersionId String
  kind                        TaxonomyKind
  name                        String
  slug                        String
  description                 String?
  seoTitle                    String?
  seoDescription              String?
  data                        Json         @default("{}")
  parentId                    String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  site                      Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  taxonomyDefinition        TaxonomyDefinition         @relation(fields: [taxonomyDefinitionId], references: [id], onDelete: Cascade)
  taxonomyDefinitionVersion TaxonomyDefinitionVersion  @relation(fields: [taxonomyDefinitionVersionId], references: [id])
  parent                    TaxonomyTerm?              @relation("TaxonomyTermHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                  TaxonomyTerm[]             @relation("TaxonomyTermHierarchy")
  entries                   ContentEntryTaxonomyTerm[]

  @@unique([taxonomyDefinitionId, slug])
  @@index([siteId, kind])
  @@index([taxonomyDefinitionId])
  @@index([parentId])
}

model ContentTypeTaxonomy {
  siteId        String
  contentTypeId String
  taxonomy      TaxonomyKind

  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@id([contentTypeId, taxonomy])
  @@index([siteId, taxonomy])
}

model ContentEntryTaxonomyTerm {
  siteId  String
  entryId String
  termId  String

  site  Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  term  TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([entryId, termId])
  @@index([siteId])
  @@index([termId])
}

model ContentRevision {
  id             String             @id @default(cuid())
  entryId        String
  revision       Int
  data           Json
  status         ContentEntryStatus
  title          String             @default("")
  slug           String             @default("")
  excerpt        String?
  seoTitle       String?
  seoDescription String?
  createdById    String?
  createdAt      DateTime           @default(now())

  entry       ContentEntry             @relation("EntryRevisions", fields: [entryId], references: [id], onDelete: Cascade)
  publishedBy ContentEntry?            @relation("EntryPublishedRevision")
  terms       RevisionTaxonomyTerm[]

  @@unique([entryId, revision])
  @@index([entryId])
}

model RevisionTaxonomyTerm {
  revisionId String
  termId     String
  kind       String
  name       String
  slug       String

  revision ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@id([revisionId, termId])
  @@index([revisionId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  siteId         String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([siteId])
  @@index([actorId])
  @@index([createdAt])
}

model SiteMembership {
  id        String             @id @default(cuid())
  siteId    String
  userId    String
  role      SiteMembershipRole
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  site      Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([userId])
}

model Invitation {
  id               String                      @id @default(cuid())
  email            String
  organizationId   String
  siteId           String?
  organizationRole OrganizationMembershipRole?
  siteRole         SiteMembershipRole?
  tokenHash        String                      @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdById      String
  createdAt        DateTime                    @default(now())
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site?                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy        User                        @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([siteId])
  @@index([email])
  @@index([expiresAt])
}

// Preview tokens let editors share a time-limited URL to preview draft content.
// The raw token is revealed once; only the HMAC-SHA256 hash is persisted.
model PreviewToken {
  id          String    @id @default(cuid())
  siteId      String
  // Optional: scope the token to a single entry (null = whole-site preview)
  entryId     String?
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  label       String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())

  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entry       ContentEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("PreviewTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([entryId])
  @@index([expiresAt])
}
