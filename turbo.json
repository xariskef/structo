{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ADMIN_APP_URL",
    "API_PORT",
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  }
}
